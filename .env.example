# Copy to .env and fill in real values. NEVER commit .env or real secrets.

# PostgreSQL connection (matches docker-compose.yml dev defaults)
DATABASE_URL=postgresql://user:pass@localhost:5432/salon

# SMTP — contract fixed per docs/DESIGN.md §8; used from Sprint 5 (TASK-502)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user_here
SMTP_PASSWORD=your_smtp_password_here
SMTP_FROM=no-reply@example.com
